{
  "openapi": "3.1.0",
  "info": {
    "title": "Regar Mart API",
    "version": "1.0.0",
    "description": "Dokumentasi lengkap API untuk sistem e-commerce Regar Mart",
    "contact": {
      "email": "flyhighsinergi.idn@gmail.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    },
    {
      "url": "https://api.regarmart.com",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Endpoints untuk autentikasi pengguna"
    },
    {
      "name": "Products",
      "description": "Manajemen produk dan katalog"
    },
    {
      "name": "Cart",
      "description": "Operasi keranjang belanja"
    },
    {
      "name": "Orders",
      "description": "Manajemen pesanan"
    },
    {
      "name": "Admin",
      "description": "Operasi khusus admin"
    },
    {
      "name": "Payment",
      "description": "Proses pembayaran"
    }
  ],
  "paths": {
    "/api/auth/[...nextauth]": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Handle authentication callback",
        "description": "Endpoint untuk menangani callback dari provider OAuth",
        "responses": {
          "302": {
            "description": "Redirect setelah autentikasi berhasil"
          }
        }
      },
      "post": {
        "tags": ["Authentication"],
        "summary": "Authenticate user",
        "description": "Endpoint untuk proses autentikasi",
        "responses": {
          "200": {
            "description": "Autentikasi berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": ["Products"],
        "summary": "Get product list",
        "description": "Mendapatkan daftar produk dengan pagination dan filter",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Nomor halaman",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Jumlah item per halaman",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "description": "Filter berdasarkan kategori",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Pencarian produk",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar produk",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get product details",
        "description": "Mendapatkan detail produk berdasarkan ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID produk",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detail produk",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "description": "Produk tidak ditemukan"
          }
        }
      }
    },
    "/api/cart": {
      "get": {
        "tags": ["Cart"],
        "summary": "Get user cart",
        "description": "Mendapatkan isi keranjang belanja pengguna",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "Isi keranjang belanja",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CartItem"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Cart"],
        "summary": "Add item to cart",
        "description": "Menambahkan produk ke keranjang belanja",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productId": {
                    "type": "string",
                    "description": "ID produk"
                  },
                  "quantity": {
                    "type": "integer",
                    "description": "Jumlah produk",
                    "minimum": 1
                  }
                },
                "required": ["productId", "quantity"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item berhasil ditambahkan"
          }
        }
      }
    },
    "/api/cart/{itemId}": {
      "put": {
        "tags": ["Cart"],
        "summary": "Update cart item",
        "description": "Mengupdate jumlah produk dalam keranjang",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "description": "ID item keranjang",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "description": "Jumlah baru",
                    "minimum": 1
                  }
                },
                "required": ["quantity"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item berhasil diupdate"
          }
        }
      },
      "delete": {
        "tags": ["Cart"],
        "summary": "Remove item from cart",
        "description": "Menghapus produk dari keranjang",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "description": "ID item keranjang",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item berhasil dihapus"
          }
        }
      }
    },
    "/api/orders": {
      "post": {
        "tags": ["Orders"],
        "summary": "Create new order",
        "description": "Membuat pesanan baru dari keranjang belanja",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pesanan berhasil dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Orders"],
        "summary": "Get user orders",
        "description": "Mendapatkan daftar pesanan pengguna",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "Daftar pesanan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/products": {
      "post": {
        "tags": ["Admin", "Products"],
        "summary": "Create new product",
        "description": "Membuat produk baru (admin only)",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produk berhasil dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          }
        }
      }
    },
    "/api/payment/qris/generate": {
      "post": {
        "tags": ["Payment"],
        "summary": "Generate QRIS payment",
        "description": "Generate kode QRIS untuk pembayaran",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "orderId": {
                    "type": "integer",
                    "description": "ID pesanan"
                  },
                  "amount": {
                    "type": "number",
                    "description": "Jumlah pembayaran"
                  }
                },
                "required": ["orderId", "amount"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "QRIS berhasil digenerate",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "qrCode": {
                      "type": "string",
                      "description": "URL atau data QR code"
                    },
                    "expiry": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Waktu kedaluwarsa"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "float"
          },
          "stock": {
            "type": "integer"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "CartItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "quantity": {
            "type": "integer"
          },
          "subtotal": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "OrderRequest": {
        "type": "object",
        "properties": {
          "deliveryAddress": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "paymentMethod": {
            "type": "string",
            "enum": ["COD", "QRIS"]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": ["deliveryAddress", "phone", "paymentMethod"]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "totalAmount": {
            "type": "number",
            "format": "float"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"]
          },
          "paymentMethod": {
            "type": "string"
          },
          "deliveryStatus": {
            "type": "string",
            "enum": ["PREPARING", "ON_THE_WAY", "DELIVERED"]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "quantity": {
            "type": "integer"
          },
          "unitPrice": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "ProductCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "float"
          },
          "stock": {
            "type": "integer"
          },
          "categoryId": {
            "type": "integer",
            "format": "int64"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["name", "price", "stock", "categoryId"]
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "image": {
                "type": "string",
                "format": "uri"
              },
              "role": {
                "type": "string"
              }
            }
          },
          "expires": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}